#######################################
# The Orlov Family — custom settings  #
# Appended to aa-docker/conf/local.py #
#######################################

INSTALLED_APPS += [
    "allianceauth.eveonline.autogroups",   # corp_<TICKER> groups
]

# --- Discord service -------------------------------------------------------
# Redirect in the Discord developer portal must be exactly DISCORD_CALLBACK_URL
# (trailing slash included). Secrets come from .env, never from this file.
DISCORD_CALLBACK_URL = f"{SITE_URL}/discord/callback/"  # Do NOT change this line!
DISCORD_GUILD_ID = os.environ.get("DISCORD_GUILD_ID", "")
DISCORD_APP_ID = os.environ.get("DISCORD_APP_ID", "")
DISCORD_APP_SECRET = os.environ.get("DISCORD_APP_SECRET", "")
DISCORD_BOT_TOKEN = os.environ.get("DISCORD_BOT_TOKEN", "")
DISCORD_SYNC_NAMES = True   # format set in admin > Services > Name format config: "[{corp_ticker}] {character_name}". Server owner: see docs/design/membership.md policy 5

CELERYBEAT_SCHEDULE["discord.update_all_usernames"] = {
    "task": "discord.update_all_usernames",
    "schedule": crontab(minute="0", hour="*/12"),
}

# --- Corp Stats (registered vs unregistered members) -----------------------
CELERYBEAT_SCHEDULE["update_all_corpstats"] = {
    "task": "allianceauth.corputils.tasks.update_all_corpstats",
    "schedule": crontab(minute="0", hour="*/6"),
}

# --- Member Audit (Day 3) --------------------------------------------------
INSTALLED_APPS += [
    "eveuniverse",   # EVE static data, required by memberaudit
    "memberaudit",
]
CELERYBEAT_SCHEDULE["memberaudit_run_regular_updates"] = {
    "task": "memberaudit.tasks.run_regular_updates",
    "schedule": 3600,  # seconds; memberaudit 5.x wants a number, not a crontab
}

# --- Discord: refresh nicknames periodically (corp changes don't trigger a nick update otherwise)
CELERYBEAT_SCHEDULE["discord.update_all_nicknames"] = {
    "task": "discord.update_all_nicknames",
    "schedule": crontab(minute="30", hour="*/6"),
}

# --- Day 5: moon timers (aa-structures, aa-moonmining, aa-structuretimers) --
INSTALLED_APPS += [
    "structures",        # structures + EVE notifications -> Discord webhooks
    "moonmining",        # extraction board, ore values, mining ledger
    "structuretimers",   # timer board II (own extractions auto-added, others by hand)
]

# structures: owned by the holding corp only; no POS / POCO / skyhooks to track
STRUCTURES_FEATURE_STARBASES = False
STRUCTURES_FEATURE_CUSTOMS_OFFICES = False
STRUCTURES_FEATURE_SKYHOOKS = False
STRUCTURES_ADD_TIMERS = True                  # push extraction timers into structuretimers
STRUCTURES_MOON_EXTRACTION_TIMERS_ENABLED = True
STRUCTURES_NOTIFICATION_SHOW_MOON_ORE = True  # ore list in the Discord "extraction started" post

CELERYBEAT_SCHEDULE["structures_update_all_structures"] = {
    "task": "structures.tasks.update_all_structures",
    "schedule": 1800,
}
CELERYBEAT_SCHEDULE["structures_fetch_all_notifications"] = {
    "task": "structures.tasks.fetch_all_notifications",
    "schedule": 300,
}

CELERYBEAT_SCHEDULE["moonmining_run_regular_updates"] = {
    "task": "moonmining.tasks.run_regular_updates",
    "schedule": crontab(minute="*/10"),
}
CELERYBEAT_SCHEDULE["moonmining_run_report_updates"] = {
    "task": "moonmining.tasks.run_report_updates",
    "schedule": crontab(minute="30", hour="*/1"),
}
CELERYBEAT_SCHEDULE["moonmining_run_value_updates"] = {
    "task": "moonmining.tasks.run_calculated_properties_update",
    "schedule": crontab(minute="30", hour="3"),
}

CELERYBEAT_SCHEDULE["structuretimers_housekeeping"] = {
    "task": "structuretimers.tasks.housekeeping",
    "schedule": 10800,
}
CELERYBEAT_SCHEDULE["structuretimers_dispatch_scheduled_notifications"] = {
    "task": "structuretimers.tasks.dispatch_scheduled_notifications",
    "schedule": 60,
}

# --- Day 6: Discord bot with the /moons command (allianceauth-discordbot) ---
INSTALLED_APPS += [
    "aadiscordbot",   # bot framework; runs in its own container (allianceauth_discordbot)
    "orlovbot",       # our own commands, bind-mounted from aa-docker/orlovbot
]

# Only the bundled commands we use (/about, /time). The default list loads 17 modules
# (sov, price check, easter eggs, ...). Our own /moons is added by orlovbot/auth_hooks.py.
DISCORD_BOT_COGS = [
    "aadiscordbot.cogs.about",
    "aadiscordbot.cogs.time",
]

# --- Moon board: one always-current message in #moon-board (runbook 09) -----
ORLOVBOT_MOON_BOARD_CHANNEL = "moon-board"   # channel name; "" switches the board off

# Bot log lines go to the container output: docker compose logs allianceauth_discordbot
LOGGING["loggers"]["aadiscordbot"] = {"handlers": ["console"], "level": "INFO"}
LOGGING["loggers"]["orlovbot"] = {"handlers": ["console"], "level": "INFO"}

# --- Structure board: one always-current message in #structure-board (runbook 10) ---
ORLOVBOT_STRUCTURE_BOARD_CHANNEL = "structure-board"   # channel name; "" switches the board off
# Names of the structure profiles. EVE's API only gives the number; add "number: name" pairs.
ORLOVBOT_STRUCTURE_PROFILES = {
}

# Structure board alerts (runbook 10): a ping in the same channel when a new war appears, and
# once a day per structure while its fuel is under 7 days or a service is offline.
ORLOVBOT_STRUCTURE_ALERTS = True
ORLOVBOT_STRUCTURE_ALERT_MENTION = "@everyone"

# --- Kill feed: a post in #zkillboard for every kill and loss (runbook 11) ----
ORLOVBOT_KILLFEED_CHANNEL = "zkillboard"      # channel name; "" switches the feed off
ORLOVBOT_KILLFEED_ALLIANCE_IDS = [99015337]   # The Orlov Family
ORLOVBOT_KILLFEED_CORPORATION_IDS = []        # extra corps outside the alliance, by corporation ID
ORLOVBOT_KILLFEED_STREAM = True               # live feed from zKillboard's R2Z2 files; False leaves only the 5-minute check

# Structure board: the reinforcement hour (EVE time) every structure must have, per the
# contract with the mercenaries on retainer. Shown green when it matches, red when not.
ORLOVBOT_STRUCTURE_REINFORCE_HOUR = 21

# --- Jump freighter watch: JF losses EVE-wide in #jf-gank-board (runbook 12) ---
ORLOVBOT_JFWATCH_CHANNEL = "jf-gank-board"       # channel name; "" switches the watch off
ORLOVBOT_JFWATCH_SPACE = ["highsec", "lowsec"]   # also possible: "nullsec", "wormhole"

# --- Juicy killmails: the expensive and rare losses of all EVE in #juicy-killmails (runbook 18) ---
# Fed by the kill feed's live reader (ORLOVBOT_KILLFEED_STREAM must stay True). Thresholds in billions.
ORLOVBOT_JUICY_CHANNEL = "juicy-killmails"   # channel name; "" switches the feed off
ORLOVBOT_JUICY_FACTION_B = 20                # faction hulls (navy, pirate, CONCORD)
ORLOVBOT_JUICY_JUMP_FREIGHTER_B = 15
ORLOVBOT_JUICY_FREIGHTER_B = 8               # freighters, Bowhead, Orca, Porpoise
ORLOVBOT_JUICY_HAULER_B = 10                 # T1 haulers, blockade runners, deep space transports
ORLOVBOT_JUICY_BLACK_OPS_B = 12
ORLOVBOT_JUICY_SHIP_B = 10                   # any other non-capital ship
ORLOVBOT_JUICY_EXTRA_TYPE_IDS = []           # more hulls to post whatever their value, by type id

# --- Shipyard (ship-building dashboard, runbook 13) ------------------------
INSTALLED_APPS += ["shipyard"]
CELERYBEAT_SCHEDULE["shipyard_refresh_all"] = {
    "task": "shipyard.tasks.refresh_all",           # EVE Ref builds + prices + volumes
    "schedule": crontab(minute="10", hour="*/6"),
}
CELERYBEAT_SCHEDULE["shipyard_refresh_prices_and_stats"] = {
    "task": "shipyard.tasks.refresh_prices_and_stats",  # Fuzzwork + ESI history only
    "schedule": crontab(minute="40"),
}

# --- Shipyards front door: shipyards.orlovfamily.space (runbook 14) --------------
# The same Django app under a second hostname; the plugin's middleware routes it.
SHIPYARD_STANDALONE_HOST = "shipyards.orlovfamily.space"   # "" switches the front door off
MIDDLEWARE += ["shipyard.middleware.StandaloneHostMiddleware"]
# one login for both hostnames
SESSION_COOKIE_DOMAIN = ".orlovfamily.space"
CSRF_COOKIE_DOMAIN = ".orlovfamily.space"
CSRF_TRUSTED_ORIGINS += ["https://shipyards.orlovfamily.space"]

# Shipyard: jobs, blueprints and assets of the members' characters (runbook 14, phase 2)
CELERYBEAT_SCHEDULE["shipyard_refresh_industry"] = {
    "task": "shipyard.tasks.refresh_industry",
    "schedule": crontab(minute="5,35"),
}

# Shipyard: pirate/Trig/EDENCOM blueprint prices from public contracts (EVE Ref snapshot, hourly)
CELERYBEAT_SCHEDULE["shipyard_refresh_lp_store"] = {
    "task": "shipyard.tasks.refresh_lp_store",        # the militia LP store: offers + Jita prices + daily volumes (0.15.0)
    "schedule": crontab(minute="50", hour="3"),
}
CELERYBEAT_SCHEDULE["shipyard_refresh_lp_prices"] = {
    "task": "shipyard.tasks.refresh_lp_prices",       # Jita prices of the LP store's types only
    "schedule": crontab(minute="45"),
}
CELERYBEAT_SCHEDULE["shipyard_refresh_contract_prices"] = {
    "task": "shipyard.tasks.refresh_contract_prices",
    "schedule": crontab(minute="50"),
}

# Shipyard: the structure corp's wallet journal into the Structure income ledger (hourly)
CELERYBEAT_SCHEDULE["shipyard_refresh_corp_wallet"] = {
    "task": "shipyard.tasks.refresh_corp_wallet",
    "schedule": crontab(minute="15"),
}

# My business: the jobs token also carries the corporation wallet scopes (owner, 2026-10-18), so the character
# that connects the jobs (Catherine Frey, Factory Manager + Accountant in OARMI) lets sessions read the master wallet.
SHIPYARD_PRODUCTION_SCOPES = ["esi-industry.read_corporation_jobs.v1", "esi-wallet.read_corporation_wallets.v1", "esi-corporations.read_divisions.v1", "esi-markets.read_corporation_orders.v1"]  # orders since 2026-10-20 (Finance tab)

# Shipyard: the corporation's hangars from EVE, for the goods held on the Finance tab (0.27.0, hourly).
# The projects hangar: narrow with SHIPYARD_BOOKS_HANGAR_LOCATIONS (structure ids) and SHIPYARD_BOOKS_HANGAR_FLAGS (e.g. ["CorpSAG2"]).
CELERYBEAT_SCHEDULE["shipyard_refresh_hangar"] = {
    "task": "shipyard.tasks.refresh_hangar",
    "schedule": crontab(minute="35"),
}
# Shipyard 0.29.0, the Bargains tab: EVE Ref's daily market-history archive (one small file a day, no ESI history calls) and Jita prices via Fuzzwork.
CELERYBEAT_SCHEDULE["shipyard_refresh_market_history"] = {
    "task": "shipyard.tasks.refresh_market_history",
    "schedule": crontab(minute="30", hour="13"),
}
CELERYBEAT_SCHEDULE["shipyard_refresh_bargain_prices"] = {
    "task": "shipyard.tasks.refresh_bargain_prices",
    "schedule": crontab(minute="5", hour="*/2"),
}
# The projects hangar (0.28.0): by default the office the corporation projects deliver to (EVE records it per project), every hangar
# division there. Leave both empty; set them only to override (the pin of 2026-10-23 to structure 1055529310484, division 2, was the
# reprocessing hangar the owner moves goods to, not the projects hangar).
SHIPYARD_BOOKS_HANGAR_LOCATIONS = []
SHIPYARD_BOOKS_HANGAR_FLAGS = []

# Shipyard: the LP log, every character's loyalty points read once an hour (0.23.0)
CELERYBEAT_SCHEDULE["shipyard_lp_snapshots"] = {
    "task": "shipyard.tasks.snapshot_lp",
    "schedule": crontab(minute="50"),
}

# Shipyard: the production corp's industry jobs for the My business tab (hourly)
CELERYBEAT_SCHEDULE["shipyard_refresh_corp_industry_jobs"] = {
    "task": "shipyard.tasks.refresh_corp_industry_jobs",
    "schedule": crontab(minute="20"),
}

# Shipyard: compressed ore and ice catalog for the Reprocessing tab (EVE Ref, weekly)
CELERYBEAT_SCHEDULE["shipyard_refresh_ore_catalog"] = {
    "task": "shipyard.tasks.refresh_ore_catalog",
    "schedule": crontab(minute="20", hour="4", day_of_week="sunday"),
}

# Shipyard: modules of the Scrapmetal tab (owner's list + EVE Ref, weekly)
CELERYBEAT_SCHEDULE["shipyard_refresh_scrap_catalog"] = {
    "task": "shipyard.tasks.refresh_scrap_catalog",
    "schedule": crontab(minute="30", hour="4", day_of_week="sunday"),
}

# Shipyard: the Finance tab opens a new reporting period at every State of the Alliance post on the alliance site (hourly)
CELERYBEAT_SCHEDULE["shipyard_books_check_periods"] = {
    "task": "shipyard.tasks.books_check_periods",
    "schedule": crontab(minute="45"),
}

# Shipyard: the executor corp's projects into the Corp projects snapshots (hourly)
CELERYBEAT_SCHEDULE["shipyard_refresh_corp_projects"] = {
    "task": "shipyard.tasks.refresh_corp_projects",
    "schedule": crontab(minute="25"),
}

# --- Doctrines: fleet doctrines behind auth at doctrines.orlovfamily.space (runbook 16) ----
INSTALLED_APPS += ["doctrines"]
DOCTRINES_HOST = ""                                  # "doctrines.orlovfamily.space" once DNS and the proxy host exist (runbook 16 C); "" = auth's host only
MIDDLEWARE += ["doctrines.middleware.DoctrinesHostMiddleware"]
CSRF_TRUSTED_ORIGINS += ["https://doctrines.orlovfamily.space"]
CELERYBEAT_SCHEDULE["doctrines_refresh_prices"] = {
    "task": "doctrines.tasks.refresh_prices",
    "schedule": crontab(minute="35"),
}
CELERYBEAT_SCHEDULE["doctrines_refresh_insurance"] = {
    "task": "doctrines.tasks.refresh_insurance",
    "schedule": crontab(minute="40", hour="5"),
}
# SRP (runbook 17): the SRP wallet (OARMI division 2) checked hourly for payouts with the kill id in the reason
DOCTRINES_SRP_WALLET_DIVISION = 2
CELERYBEAT_SCHEDULE["doctrines_srp_match_payments"] = {
    "task": "doctrines.tasks.srp_match_payments",
    "schedule": crontab(minute="50"),
}

# Journal lines left out of the Finance tab by their reason (owner, 2026-10-20 "accidental"; 2026-10-21 "correction" too)
SHIPYARD_BOOKS_IGNORE_REASONS = [r"accidental", r"correction"]

# --- Welcome DM (runbook 19): every new Discord member gets the link to #how-to-get-roles ---
ORLOVBOT_WELCOME = True
ORLOVBOT_WELCOME_CHANNEL_ID = 1555292924374417471   # #how-to-get-roles
